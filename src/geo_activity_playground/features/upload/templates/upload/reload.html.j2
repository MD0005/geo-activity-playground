{% extends "page.html.j2" %}

{% block container %}
<h1>{{ _('Reloading') }}</h1>

<p>{{ _('Checking for new activities, importing them and adding them to the database. This might take a while …') }}</p>

<div class="progress" role="progressbar" aria-label="Animated striped example" aria-valuenow="100" aria-valuemin="0"
    aria-valuemax="100">
    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
</div>

<script type="text/javascript">
    fetch("{{ url_for('.execute_reload') }}", { method: "POST" }).then(() => {
        window.location.replace("{{ url_for('index') }}");
    });
</script>
{% endblock %}